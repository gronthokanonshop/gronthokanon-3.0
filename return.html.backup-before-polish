/* ══ WA FLOAT / TOAST ══ */
.wa-float{position:fixed;bottom:84px;right:18px;z-index:140;width:48px;height:48px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 6px 20px rgba(37,211,102,0.4);text-decoration:none;transition:transform 0.2s;}
