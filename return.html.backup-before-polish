<script>
function doSearch(){
  const q = document.getElementById('searchInp').value.trim();
  if(q) location.href = 'filter.html?q=' + encodeURIComponent(q);
  else location.href = 'filter.html';
}
function toggleMenu(){
  const s = document.querySelector('.nav-search');
  if(s){ s.style.display = s.style.display==='flex' ? 'none':'flex'; s.style.position='absolute'; s.style.top='64px'; s.style.left='0'; s.style.right='0'; s.style.margin='0'; s.style.borderRadius='0'; s.style.maxWidth='100%';}
}
function updateCartBadge(){
  let c = 0;
  try{ c = JSON.parse(localStorage.getItem('od_cart2')||'[]').reduce((s,i)=>s+(i.qty||1),0); }catch(e){}
  const el = document.getElementById('cartCount');
  const bn = document.getElementById('bnCart');
  if(el) el.textContent = c;
  if(bn) bn.textContent = c;
}
updateCartBadge();
</script>
