<!-- বইয়ের ডেটা: book.js (মূল তালিকা) + books-live.js (অ্যাডমিন থেকে সেভ করা পরিবর্তন লাইভ দেখায়) -->
<script src="book.js"></script>
<script src="books-live.js"></script>
<script>
/* ══════════════════════════════════════
   STATE
══════════════════════════════════════ */
let currentBook = null;
let qty = 1;
let wished = false;
/* কিছু ব্রাউজার/মোডে localStorage বন্ধ থাকতে পারে — তখনও যেন সাইট ক্র্যাশ না করে */
function odGet(k, fb){ try{ const v = localStorage.getItem(k); return v!==null ? JSON.parse(v) : fb; }catch(e){ return fb; } }
function odSet(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
const cart = odGet('od_cart2', []);
let wishlist = odGet('od_wishlist', []);

/* ══════════════════════════════════════
   LOAD BOOK FROM URL PARAM
══════════════════════════════════════ */
function getParam(key){
  return new URLSearchParams(location.search).get(key);
}

function init(){
  const bid = getParam('id') || (books.length ? books[0].bid : null);
  if(!bid){ document.getElementById('mainContent').innerHTML = '<p style="padding:40px;color:var(--muted);">পণ্য পাওয়া যায়নি।</p>'; return; }
  const book = books.find(b => b.bid === bid);
  if(!book){ document.getElementById('mainContent').innerHTML = '<p style="padding:40px;color:var(--muted);">পণ্য পাওয়া যায়নি।</p>'; return; }
  currentBook = book;
  renderBook(book);
  renderRelated(book);
  trackRecentlyViewed(book.bid);
  renderRecentlyViewed(book.bid);
  updateCartBadge();
  updateWishBadge();
  syncWishState();
  loadStock(book.bid);
  loadReviews(book.bid);
  initStarPicker();
  buildMenuCats();
}

/* ══════════════════════════════════════
   মেনু ড্রয়ার
══════════════════════════════════════ */
function openMenu(){
  document.getElementById('menuDrawer').classList.add('open');
  document.getElementById('menuOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeMenu(){
  document.getElementById('menuDrawer').classList.remove('open');
  document.getElementById('menuOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
function buildMenuCats(){
  const mdCatLinks = document.getElementById('mdCatLinks');
  const mdCatTitle = document.getElementById('mdCatTitle');
  if(!mdCatLinks || typeof books === 'undefined') return;
  const subcats = [...new Set(books.map(b=>b.subcat).filter(Boolean))].slice(0,8);
  if(subcats.length){
    mdCatTitle.style.display = 'block';
    mdCatLinks.innerHTML = subcats.map(s =>
      `<a class="md-link" href="filter.html?subcat=${encodeURIComponent(s)}"><span class="ic">📖</span> ${s}</a>`
    ).join('');
  }
}

/* ══════════════════════════════════════
   RENDER
══════════════════════════════════════ */
function renderBook(b){
  // nav & breadcrumb
  document.title = b.name + ' — OurDedication';
  document.getElementById('navTitle').textContent = b.name;
  document.getElementById('bcTitle').textContent = b.name;

  // SEO — প্রতিটা বইয়ের জন্য আলাদা মেটা ডেসক্রিপশন/OG ট্যাগ
  const seoDesc = `${b.name}${b.author ? ' — ' + b.author : ''} — ৳${b.price} — OurDedication-এ অর্ডার করুন, সারাদেশে হোম ডেলিভারি ও ক্যাশ অন ডেলিভারি সুবিধা।`;
  const pageUrl = `https://ourdedication.com/product.html?id=${encodeURIComponent(b.bid)}`;
  document.getElementById('metaDesc').setAttribute('content', seoDesc);
  document.getElementById('metaCanonical').setAttribute('href', pageUrl);
  document.getElementById('metaOgTitle').setAttribute('content', b.name + ' — OurDedication');
  document.getElementById('metaOgDesc').setAttribute('content', seoDesc);
  document.getElementById('metaOgUrl').setAttribute('content', pageUrl);
  if(b.img && /^https?:\/\//.test(b.img)) document.getElementById('metaOgImage').setAttribute('content', b.img);

  // image
  const img = document.getElementById('mainImg');
  img.src = b.img || 'https://via.placeholder.com/300x400/0d1530/6366f1?text=📚';
  img.alt = b.name;

  // thumbs — show 1 thumb (cover) + color variants as placeholders
  const thumbsRow = document.getElementById('thumbsRow');
  thumbsRow.innerHTML = `
    <div class="thumb active" onclick="setImg('${b.img}',this)">
      <img src="${b.img}" alt="" onerror="this.src='https://via.placeholder.com/60x76/0d1530/6366f1?text=📚'">
    </div>`;

  // badges (image)
  let badges = '';
  if(b.original_price && b.original_price > b.price){
    const badgeDisc = Math.round((1 - b.price/b.original_price)*100);
    badges += `<span class="img-badge ib-sale"><span class="ib-pct">${badgeDisc}%</span><span class="ib-lbl">ছাড়</span></span>`;
  }
  document.getElementById('imgBadges').innerHTML = badges;

  // PDF প্রিভিউ বাটন
  const pdfBtn = document.getElementById('pdfPreviewBtn');
  if(pdfBtn) pdfBtn.style.display = (b.pdfLink && b.pdfLink.trim()) ? 'flex' : 'none';

  // top badges
  let topB = '';
  if(b.cat)    topB += `<span class="it-badge itb-cat">${b.cat}</span>`;
  if(b.subcat) topB += `<span class="it-badge itb-sub">${b.subcat}</span>`;
  document.getElementById('topBadges').innerHTML = topB;

  // title & author
  document.getElementById('bookTitle').textContent = b.name;
  document.getElementById('bookAuthor').textContent = b.author || 'অজানা';

  // price
  document.getElementById('priceVal').textContent = b.price.toLocaleString('bn-BD');
  if(b.original_price && b.original_price > b.price){
    const disc = Math.round((1 - b.price/b.original_price)*100);
    const save = b.original_price - b.price;
    document.getElementById('oldPriceWrap').style.display = 'block';
    document.getElementById('priceOld').textContent = '৳' + b.original_price.toLocaleString('bn-BD');
    document.getElementById('priceDisc').textContent = disc + '% ছাড়';
    document.getElementById('priceSave').style.display = 'block';
    document.getElementById('priceSave').textContent = '৳' + save.toLocaleString('bn-BD') + ' সাশ্রয়!';
  }

  // whatsapp
