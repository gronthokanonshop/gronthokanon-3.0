let rfRating = 0;
function initStarPicker(){
  document.querySelectorAll('#rfStars span').forEach(s => {
    s.onclick = () => {
      rfRating = Number(s.dataset.v);
      document.getElementById('rfStars').dataset.rating = rfRating;
      document.querySelectorAll('#rfStars span').forEach(x => {
        x.classList.toggle('on', Number(x.dataset.v) <= rfRating);
        x.textContent = Number(x.dataset.v) <= rfRating ? '★' : '☆';
      });
    };
  });
}

function timeAgoBn(ts){
  const diff = Date.now() - ts;
  const day = 86400000;
  if(diff < 3600000) return 'কিছুক্ষণ আগে';
  if(diff < day) return Math.floor(diff/3600000) + ' ঘণ্টা আগে';
  if(diff < day*30) return Math.floor(diff/day) + ' দিন আগে';
  return new Date(ts).toLocaleDateString('bn-BD');
}

function loadReviews(bid){
  if(typeof db === 'undefined'){ document.getElementById('reviewsWrap').innerHTML = '<div class="reviews-empty">এখনো Firebase সংযোগ দেওয়া হয়নি</div>'; return; }
  db.ref('reviews/' + bid).get().then(snap => {
    const val = snap.val();
    const list = val ? Object.keys(val).map(k => ({key:k, ...val[k]})) : [];
    list.sort((a,b) => (b.createdAt||0) - (a.createdAt||0));

    document.getElementById('reviewTabCount').textContent = list.length.toLocaleString('bn-BD');
    if(!list.length){
      document.getElementById('ratingNum').textContent = 'নতুন';
      document.getElementById('ratingCount').textContent = '(এখনো কোনো রিভিউ নেই)';
      document.getElementById('ratingStars').textContent = '☆☆☆☆☆';
      document.getElementById('reviewsWrap').innerHTML = '<div class="reviews-empty">এখনো কোনো রিভিউ নেই — প্রথম রিভিউটি আপনি লিখুন! ✍️</div>';
      return;
    }

    const avg = list.reduce((s,r) => s + (r.rating||0), 0) / list.length;
    document.getElementById('ratingNum').textContent = avg.toFixed(1);
    document.getElementById('ratingCount').textContent = `(${list.length.toLocaleString('bn-BD')} টি রিভিউ)`;
    document.getElementById('ratingStars').textContent = '★'.repeat(Math.round(avg)) + '☆'.repeat(5-Math.round(avg));

    const colors = ['#CB2527,#1a1a1a','#CB2527,#1a1a1a','#10b981,#059669','#ef4444,#b91c1c','#0ea5e9,#0369a1'];
    document.getElementById('reviewsWrap').innerHTML = list.slice(0,30).map((r,i) => `
      <div class="review-card">
        <div class="rv-head">
          <div class="rv-avatar" style="background:linear-gradient(135deg,${colors[i%colors.length]})">${(r.name||'?').trim()[0]||'?'}</div>
          <div>
            <div class="rv-name">${escapeHTML(r.name||'অজ্ঞাত')}</div>
            <div class="rv-date">${r.createdAt ? timeAgoBn(r.createdAt) : ''}</div>
          </div>
        </div>
        <div class="rv-stars">${'★'.repeat(r.rating||0)}${'☆'.repeat(5-(r.rating||0))}</div>
        <p class="rv-text">${escapeHTML(r.comment||'')}</p>
      </div>`).join('');
  }).catch(() => {
    document.getElementById('reviewsWrap').innerHTML = '<div class="reviews-empty">রিভিউ লোড করা যায়নি</div>';
  });
}

function escapeHTML(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

async function submitReview(){
  const name = document.getElementById('rfName').value.trim();
  const comment = document.getElementById('rfComment').value.trim();
  if(!name){ showToast('নাম লিখুন'); return; }
  if(!rfRating){ showToast('রেটিং দিন (তারকা ক্লিক করুন)'); return; }
  if(!comment){ showToast('মতামত লিখুন'); return; }
  if(!currentBook || typeof db === 'undefined'){ showToast('এখনো Firebase সংযোগ দেওয়া হয়নি'); return; }
  try{
    await db.ref('reviews/' + currentBook.bid).push().set({
      name, comment, rating: rfRating, helpful: 0, createdAt: Date.now()
    });
    document.getElementById('rfName').value = '';
    document.getElementById('rfComment').value = '';
    rfRating = 0;
    document.getElementById('rfStars').dataset.rating = 0;
    document.querySelectorAll('#rfStars span').forEach(x => { x.classList.remove('on'); x.textContent = '☆'; });
    showToast('ধন্যবাদ! আপনার রিভিউ জমা হয়েছে');
    loadReviews(currentBook.bid);
  }catch(e){
    showToast('রিভিউ জমা দেওয়া যায়নি, আবার চেষ্টা করুন');
  }
}
