}
function wishAddCart(bid){
  const c = odGet('od_cart2', []);
  if(!c.find(i=>i.bid===bid)) c.push({bid, qty:1});
  odSet('od_cart2', c);
  updateCartBadge();
  showToast('কার্টে যোগ হয়েছে! 🛒');
