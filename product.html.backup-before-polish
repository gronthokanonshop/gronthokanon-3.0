function renderCartDrawer(){
  const liveCart = odGet('od_cart2', []);
  const itemsEl = document.getElementById('cdItems');
  const footerEl = document.getElementById('cdFooter');
  document.getElementById('cdBadge').textContent = liveCart.reduce((s,i)=>s+(i.qty||1),0) + ' টি';
  if(!liveCart.length){
    itemsEl.innerHTML = `<div class="cd-empty">
      <div class="cd-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width:56px;height:56px;"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg></div>
      <h4>কার্ট খালি আছে</h4><p>পণ্য বেছে কার্টে যোগ করুন</p></div>`;
    footerEl.style.display = 'none';
    return;
  }
  let sub = 0;
  itemsEl.innerHTML = liveCart.map(item => {
    const b = books.find(x => x.bid === item.bid);
    if(!b) return '';
    const q = item.qty||1;
    sub += b.price*q;
    const img = b.img || '';
    return `<div class="cd-item">
      <div class="cd-item-img"><img src="${img}" alt="${b.name}" onerror="this.src='https://via.placeholder.com/56x74/eef2ff/6366f1?text=📚'"></div>
      <div class="cd-item-info">
        <div class="cd-item-name">${b.name}</div>
        <div class="cd-item-bottom">
          <div class="cd-item-price">৳${b.price.toLocaleString('bn-BD')}</div>
          <div class="cd-item-qty">
            <button class="cd-qbtn" onclick="cdChangeQty('${b.bid}',-1)">−</button>
            <div class="cd-qval">${q}</div>
            <button class="cd-qbtn" onclick="cdChangeQty('${b.bid}',1)">+</button>
          </div>
        </div>
      </div>
      <button class="cd-item-del" onclick="cdRemoveItem('${b.bid}')" title="সরান"><svg class="eico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>`;
  }).join('');
  document.getElementById('cdSub').textContent = '৳' + sub.toLocaleString('bn-BD');
  document.getElementById('cdTotal').textContent = '৳' + sub.toLocaleString('bn-BD');
  footerEl.style.display = 'block';
}
function cdChangeQty(bid, d){
  const c = odGet('od_cart2', []);
  const item = c.find(i => i.bid === bid);
  if(!item) return;
  item.qty = Math.max(1, (item.qty||1) + d);
  odSet('od_cart2', c);
  renderCartDrawer();
  updateCartBadge();
}
function cdRemoveItem(bid){
  let c = odGet('od_cart2', []);
  c = c.filter(i => i.bid !== bid);
  odSet('od_cart2', c);
  renderCartDrawer();
  updateCartBadge();
}

